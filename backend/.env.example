# ATLAS OS backend configuration. Copy to .env (never commit .env) or set in your
# hosting provider's secret manager. All values below are safe placeholders.

# development | production  (production turns off /api/docs unless ATLAS_ENABLE_API_DOCS=true)
ATLAS_ENV=development
# ATLAS_ENABLE_API_DOCS=true

# Local models. Default is Ollama on this machine. In Docker use http://host.docker.internal:11434
ATLAS_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Set to false to block every cloud provider (local-only mode).
ATLAS_ALLOW_EXTERNAL_PROVIDERS=true

# Optional server-side provider keys, so the browser never handles them.
# Leave unset to require a per-request key typed into the chat screen.
# ATLAS_GROQ_API_KEY=
# ATLAS_OPENROUTER_API_KEY=
# ATLAS_OPENAI_API_KEY=
# ATLAS_NVIDIA_API_KEY=
# ATLAS_TOGETHER_API_KEY=
# ATLAS_CEREBRAS_API_KEY=
# ATLAS_FIREWORKS_API_KEY=
# ATLAS_DEEPSEEK_API_KEY=

# Limits
ATLAS_LLM_RATE_LIMIT_PER_MINUTE=30
ATLAS_MAX_BODY_BYTES=262144
ATLAS_PROVIDER_CONNECT_RETRIES=2

# API login. A random per-install token is created in the data dir; this browser on the
# same computer is signed in automatically, other devices pair with the link printed by
# `python -m app.auth token`. Keep ATLAS_AUTH_REQUIRED=true.
# ATLAS_API_TOKEN=
# Extra Host names you serve ATLAS under (comma-separated), e.g. atlas.lan
# ATLAS_ALLOWED_HOSTS=

# Enable only when running locally on your own PC; defaults to disabled.
ATLAS_ENABLE_DESKTOP_AGENT=false

# Local storage (memories, chat history, tasks). Default: %LOCALAPPDATA%\AtlasOS (Windows)
# or ~/.local/share/atlas-os. Server storage is off in production unless set to true.
# ATLAS_DATA_DIR=
# ATLAS_SERVER_STORAGE=true

# Background tasks
ATLAS_TASK_CONCURRENCY=2
ATLAS_TASK_TIMEOUT_SECONDS=600
ATLAS_TASK_STEP_RETRIES=1
